# Copy to .env and fill in your own values. NEVER commit the real .env.
# Use a dedicated trading wallet funded with only what you can afford to lose.

# --- Polymarket credentials ---
POLY_PRIVATE_KEY=0xYOUR_TRADING_WALLET_PRIVATE_KEY
POLY_API_KEY=your-api-key
POLY_API_SECRET=your-api-secret
POLY_API_PASSPHRASE=your-api-passphrase
POLY_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS
POLY_SIGNATURE_TYPE=1

# --- Bot settings ---
MODE=paper          # shadow | paper | live
BANKROLL=100
LOG_LEVEL=INFO
